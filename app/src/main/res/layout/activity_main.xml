<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/background_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 سامانه ضد سرقت فعال است"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="32dp"
            android:textAlignment="viewEnd" />

        <!-- Battery Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layoutDirection="rtl">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="🔋 هشدار قطع شارژ"
                android:textSize="16sp"
                android:textColor="#444"
                android:gravity="right"
                android:textDirection="rtl" />

            <Switch
                android:id="@+id/switch_battery_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Shake Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layoutDirection="rtl">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="📳 هشدار لرزش"
                android:textSize="16sp"
                android:textColor="#444"
                android:gravity="right"
                android:textDirection="rtl" />

            <Switch
                android:id="@+id/switch_shake_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیم رمز"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSmsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تنظیم شماره گیرنده"
            android:backgroundTint="#FF9800"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>